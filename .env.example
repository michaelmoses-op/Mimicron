# Copy to .env for local docker compose

# PostgreSQL (metadata)
POSTGRES_USER=mimicron
POSTGRES_PASSWORD=mimicron_dev
POSTGRES_DB=mimicron
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# TimescaleDB (telemetry)
TIMESCALE_USER=mimicron
TIMESCALE_PASSWORD=mimicron_dev
TIMESCALE_DB=mimicron_ts
TIMESCALE_HOST=timescale
TIMESCALE_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Redpanda (Kafka API — host port 19092)
KAFKA_BROKERS=redpanda:9092

# MinIO
MINIO_ROOT_USER=mimicron
MINIO_ROOT_PASSWORD=mimicron_dev_minio
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=mimicron-archives

# Service ports (host)
CONTROL_API_PORT=8000
INGESTION_GATEWAY_PORT=8081
STREAM_GATEWAY_PORT=8082

# control-api
DATABASE_URL=postgresql+asyncpg://mimicron:mimicron_dev@localhost:5432/mimicron
JWT_SECRET=change-me-in-production
INTERNAL_API_SECRET=change-me-internal
