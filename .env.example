# Copy to .env for local docker compose

# PostgreSQL (metadata)
POSTGRES_USER=mimicron
POSTGRES_PASSWORD=mimicron_dev
POSTGRES_DB=mimicron
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# TimescaleDB (telemetry)
TIMESCALE_USER=mimicron
TIMESCALE_PASSWORD=mimicron_dev
TIMESCALE_DB=mimicron_ts
TIMESCALE_HOST=timescale
TIMESCALE_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Redpanda (Kafka API — host port 19092)
KAFKA_BROKERS=redpanda:9092

# S3-compatible object storage (MinIO locally in compose when images are available;
# RustFS provides the same API in docker-compose.yml today).
# Works with R2, B2, Spaces, GCS interoperability, or AWS S3 — same variable names.
S3_ENDPOINT=http://object-store:9000
S3_REGION=us-east-1
S3_BUCKET=mimicron-archives
S3_ACCESS_KEY=mimicron
S3_SECRET_KEY=mimicron_dev_object_store
S3_FORCE_PATH_STYLE=true

# Service ports (host)
CONTROL_API_PORT=8000
INGESTION_GATEWAY_PORT=8081
STREAM_GATEWAY_PORT=8082

# Dashboard build (browser calls these host URLs when using compose dashboard on :5173)
VITE_API_URL=http://localhost:8000
VITE_STREAM_URL=http://localhost:8082

# control-api
DATABASE_URL=postgresql+asyncpg://mimicron:mimicron_dev@localhost:5432/mimicron
JWT_SECRET=change-me-in-production
INTERNAL_API_SECRET=change-me-internal

# Observability (optional; use with compose profile all + otel-collector)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-grafana
JAEGER_UI_PORT=16686

# Production overlay (docker-compose.prod.yml)
PUBLIC_DOMAIN=localhost
ACME_EMAIL=ops@example.com
